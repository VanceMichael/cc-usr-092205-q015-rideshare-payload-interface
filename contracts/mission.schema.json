{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "多星共乘整箭构型资料",
  "type": "object",
  "required": [
    "mission",
    "rocket",
    "flight_number",
    "integrator",
    "payloads",
    "joint_tests",
    "sign_offs",
    "icd"
  ],
  "properties": {
    "mission": { "type": "string", "minLength": 1 },
    "rocket": { "type": "string", "minLength": 1 },
    "flight_number": { "type": "integer", "minimum": 1 },
    "integrator": { "type": "string", "minLength": 1 },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "developer", "interface"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "developer": { "type": "string", "minLength": 1 },
          "interface": {
            "type": "object",
            "required": [
              "name",
              "mass_kg",
              "cog_mm",
              "envelope",
              "separation",
              "power",
              "telemetry_windows",
              "no_fly_items"
            ],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string" },
              "mass_kg": { "type": "number", "exclusiveMinimum": 0 },
              "cog_mm": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              },
              "envelope": {
                "type": "object",
                "required": ["radius_mm", "height_mm"],
                "properties": {
                  "radius_mm": { "type": "number", "exclusiveMinimum": 0 },
                  "height_mm": { "type": "number", "exclusiveMinimum": 0 }
                },
                "additionalProperties": false
              },
              "separation": {
                "type": "object",
                "required": ["sequence", "time_s", "direction_deg", "spring_velocity_mps"],
                "properties": {
                  "sequence": { "type": "integer", "minimum": 1 },
                  "time_s": { "type": "number", "exclusiveMinimum": 0 },
                  "direction_deg": { "type": "number", "minimum": 0, "maximum": 360 },
                  "spring_velocity_mps": { "type": "number", "exclusiveMinimum": 0 }
                },
                "additionalProperties": false
              },
              "power": {
                "type": "object",
                "required": ["bus_voltage_v", "peak_w"],
                "properties": {
                  "bus_voltage_v": { "type": "number", "exclusiveMinimum": 0 },
                  "peak_w": { "type": "number", "exclusiveMinimum": 0 }
                },
                "additionalProperties": false
              },
              "telemetry_windows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["station", "start_s", "end_s"],
                  "properties": {
                    "station": { "type": "string", "minLength": 1 },
                    "start_s": { "type": "number", "minimum": 0 },
                    "end_s": { "type": "number", "minimum": 0 }
                  },
                  "additionalProperties": false
                }
              },
              "no_fly_items": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          },
          "internal": {
            "type": "object",
            "description": "研制方内部资料，不对其他研制方共享"
          }
        },
        "additionalProperties": false
      }
    },
    "joint_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "payloads", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "payloads": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "status": { "enum": ["planned", "in_progress", "passed", "failed"] }
        },
        "additionalProperties": false
      }
    },
    "sign_offs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["party", "scope", "conclusion", "at"],
        "properties": {
          "party": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "conclusion": { "enum": ["accepted", "conditional", "rejected"] },
          "condition": { "type": "string" },
          "at": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "icd": {
      "type": "object",
      "required": ["id", "version", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["draft", "frozen"] },
        "frozen_at": { "type": "string" },
        "waivers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "applicable_payloads", "cutoff", "re_verification"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "applicable_payloads": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "summary": { "type": "string" },
              "cutoff": { "type": "string", "minLength": 1 },
              "re_verification": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
